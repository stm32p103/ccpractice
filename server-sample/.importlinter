[importlinter]
root_packages =
    job_core
    job_core_api
    job_core_persistence
    job_core_server
    job_runner_protocol
    job_runner_agent
    job_profile_equipment_check
    job_runner_service
include_external_packages = True

[importlinter:contract:core-first-party]
name = job_core は他の first-party パッケージ(job_testing など)を import しない
type = forbidden
source_modules =
    job_core
forbidden_modules =
    job_testing

[importlinter:contract:job-layers]
name = job コンテキストの層: application → domain の向きのみ
type = layers
layers =
    job_core.job.application
    job_core.job.domain

[importlinter:contract:access-independent]
name = access コンテキストは job コンテキストを import しない
type = forbidden
source_modules =
    job_core.access
forbidden_modules =
    job_core.job
    job_core.runner

[importlinter:contract:shared-independent]
name = shared はどのコンテキストも import しない
type = forbidden
source_modules =
    job_core.shared
forbidden_modules =
    job_core.job
    job_core.access
    job_core.runner

[importlinter:contract:runner-layers]
name = runner コンテキストの層: application → domain の向きのみ
type = layers
layers =
    job_core.runner.application
    job_core.runner.domain

[importlinter:contract:job-independent-of-runner]
name = job コンテキストは runner コンテキストを import しない
type = forbidden
source_modules =
    job_core.job
forbidden_modules =
    job_core.runner

[importlinter:contract:api-independent-of-impl]
name = job_core_api は永続化・組み立て・テスト部品を import しない
type = forbidden
source_modules =
    job_core_api
forbidden_modules =
    job_core_persistence
    job_core_server
    job_testing

[importlinter:contract:persistence-independent-of-server]
name = job_core_persistence は job_core_server を import しない
type = forbidden
source_modules =
    job_core_persistence
forbidden_modules =
    job_core_server

[importlinter:contract:core-independent-of-api]
name = job_core は API・永続化・組み立てを import しない
type = forbidden
source_modules =
    job_core
forbidden_modules =
    job_core_api
    job_core_persistence
    job_core_server

[importlinter:contract:runner-protocol-standalone]
name = job_runner_protocol は他の first-party パッケージを import しない
type = forbidden
source_modules =
    job_runner_protocol
forbidden_modules =
    job_core
    job_core_api
    job_core_persistence
    job_core_server
    job_runner_agent
    job_profile_equipment_check
    job_runner_service
    job_testing

[importlinter:contract:runner-agent-independent]
name = job_runner_agent は job_runner_protocol 以外の first-party を import しない(用途固有の部品・コア・組み立てに依存しない)
type = forbidden
source_modules =
    job_runner_agent
forbidden_modules =
    job_core
    job_core_api
    job_core_persistence
    job_core_server
    job_profile_equipment_check
    job_runner_service
    job_testing

[importlinter:contract:profile-uses-ports-only]
name = job_profile_equipment_check はコア・組み立て・テスト部品を import しない
type = forbidden
source_modules =
    job_profile_equipment_check
forbidden_modules =
    job_core
    job_core_api
    job_core_persistence
    job_core_server
    job_runner_service
    job_testing

[importlinter:contract:core-independent-of-runner-agent]
name = job_core 系は runner-agent・プロファイル・組み立てを import しない
type = forbidden
source_modules =
    job_core
    job_core_api
    job_core_persistence
    job_core_server
forbidden_modules =
    job_runner_agent
    job_profile_equipment_check
    job_runner_service
